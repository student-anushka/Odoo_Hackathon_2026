const maintenanceService = require("./maintenance.service");

const createMaintenance = async (req, res) => {
  try {
    const { vehicleId, type, description, cost } = req.body;

    if (!vehicleId || !type) {
      return res
        .status(400)
        .json({ data: null, error: "vehicleId and type are required" });
    }

    const log = await maintenanceService.createMaintenance({
      vehicleId,
      type,
      description,
      cost: cost ? parseFloat(cost) : 0,
      createdById: req.user.id,
    });

    return res.status(201).json({
      data: log,
      error: null,
      message: "Maintenance log created. Vehicle is now IN_SHOP.",
    });
  } catch (err) {
    return res.status(400).json({ data: null, error: err.message });
  }
};

const closeMaintenance = async (req, res) => {
  try {
    const { id } = req.params;

    const log = await maintenanceService.closeMaintenance(id);

    return res.status(200).json({
      data: log,
      error: null,
      message: "Maintenance closed. Vehicle restored to AVAILABLE.",
    });
  } catch (err) {
    return res.status(400).json({ data: null, error: err.message });
  }
};

const getMaintenanceLogs = async (req, res) => {
  try {
    const { vehicleId, status, page = 1, limit = 20 } = req.query;

    const logs = await maintenanceService.getMaintenanceLogs({
      vehicleId,
      status,
      page: parseInt(page),
      limit: parseInt(limit),
    });

    return res.status(200).json({ data: logs, error: null });
  } catch (err) {
    return res.status(500).json({ data: null, error: err.message });
  }
};

const getMaintenanceById = async (req, res) => {
  try {
    const log = await maintenanceService.getMaintenanceById(req.params.id);

    if (!log) {
      return res
        .status(404)
        .json({ data: null, error: "Maintenance log not found" });
    }

    return res.status(200).json({ data: log, error: null });
  } catch (err) {
    return res.status(500).json({ data: null, error: err.message });
  }
};

module.exports = {
  createMaintenance,
  closeMaintenance,
  getMaintenanceLogs,
  getMaintenanceById,
};
